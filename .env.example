# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de QuizLab
# Copia este archivo como .env.local (en tu ordenador) o añádelas en Vercel
# (Project → Settings → Environment Variables). TODAS son opcionales.
# Nunca subas .env.local a Git: ya está en .gitignore.
# Las que empiezan por NEXT_PUBLIC_ son visibles en el navegador: no pongas
# nunca contraseñas ni claves secretas en ellas.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Se usa para las imágenes que ven
# WhatsApp/X al compartir. En Vercel, si la dejas vacía, se usa el dominio de
# producción automáticamente.
NEXT_PUBLIC_SITE_URL=

# Analítica sin cookies con Umami (https://umami.is, plan gratuito).
# Crea un "website" en Umami y pega aquí su ID. Vacío = sin analítica.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Solo si usas tu propio servidor de Umami (por defecto, Umami Cloud).
NEXT_PUBLIC_UMAMI_SRC=

# Formulario para recoger opiniones (p. ej. un formulario gratuito de Tally).
# Vacío = no se muestran los enlaces de "Danos tu opinión".
NEXT_PUBLIC_FEEDBACK_URL=

# Formulario de lista de espera del plan Pro (prueba de interés).
# Vacío = el botón registra el clic y avisa de que aún no está disponible.
NEXT_PUBLIC_WAITLIST_URL=

# Email de contacto para avisos de contenido inapropiado (página de privacidad).
NEXT_PUBLIC_CONTACT_EMAIL=
